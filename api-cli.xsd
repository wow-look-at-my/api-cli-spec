<?xml version="1.1" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:annotation>
		<xs:documentation>The api-cli configuration language. README.md lists the rules a reader enforces that a schema cannot state. Child elements are order-free, so every structural element uses xs:all.</xs:documentation>
	</xs:annotation>

	<xs:simpleType name="bool">
		<xs:annotation>
			<xs:documentation>"true" or "false". "1" and "yes" fail the check by name rather than read as false.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="true"/>
			<xs:enumeration value="false"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="nonEmpty">
		<xs:annotation>
			<xs:documentation>Any string of one character or more.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="interval">
		<xs:annotation>
			<xs:documentation>A Go duration ("2s", "500ms", "1m30s") or a number of seconds ("2", "1.5"). A reader holds it to its own floor.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="([0-9]+(\.[0-9]+)?(ns|us|µs|ms|s|m|h))+|[0-9]+(\.[0-9]+)?"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="path">
		<xs:annotation>
			<xs:documentation>A context path, such as "var.base_url" or "flag.dry-run".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:pattern value="[^\s]+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="overExpr">
		<xs:annotation>
			<xs:documentation>A context path to a list, or a template whose output is read as JSON. The template form reshapes a fan-out result without a shell.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="template">
		<xs:annotation>
			<xs:documentation>A Go template, rendered against the leaf context. The schema does not parse it.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="nonEmpty"/>
	</xs:simpleType>

	<xs:complexType name="valueByName">
		<xs:annotation>
			<xs:documentation>The path form of a value: it reads one context path.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="path" use="required">
			<xs:annotation>
				<xs:documentation>The context path to read.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="default" type="xs:string">
			<xs:annotation>
				<xs:documentation>The text to use when the path is empty.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="as" type="path">
			<xs:annotation>
				<xs:documentation>A template function that wraps the value, such as "shellquote".</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="expr" use="prohibited"/>
	</xs:complexType>

	<xs:complexType name="valueByExpr">
		<xs:annotation>
			<xs:documentation>The template form of a value. It takes no name=, default= or as=.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="expr" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>A verbatim template, such as "{{ .var.x | upper }}".</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="name" use="prohibited"/>
		<xs:attribute name="default" use="prohibited"/>
		<xs:attribute name="as" use="prohibited"/>
	</xs:complexType>

	<xs:element name="value">
		<xs:annotation>
			<xs:documentation>A placeholder for one value. expr= selects the template form. Otherwise name= reads a path.</xs:documentation>
		</xs:annotation>
		<xs:alternative test="@expr" type="valueByExpr"/>
		<xs:alternative type="valueByName"/>
	</xs:element>

	<xs:complexType name="ifType" mixed="true">
		<xs:annotation>
			<xs:documentation>Content that renders when test= holds. At most one else, and only inside an if.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
			<xs:sequence minOccurs="0">
				<xs:element name="else">
					<xs:annotation>
						<xs:documentation>The content after it renders when test= does not hold.</xs:documentation>
					</xs:annotation>
					<xs:complexType/>
				</xs:element>
				<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:sequence>
		<xs:attribute name="test" type="path" use="required">
			<xs:annotation>
				<xs:documentation>A context path, checked for truthiness.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="eq" type="xs:string">
			<xs:annotation>
				<xs:documentation>A literal. The test then holds when the value equals it as text.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="forType" mixed="true">
		<xs:annotation>
			<xs:documentation>Content that renders once per element of a list, with "." bound to the element.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="each" type="path" use="required">
			<xs:annotation>
				<xs:documentation>The context path of the list.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:group name="placeholders">
		<xs:annotation>
			<xs:documentation>The three placeholders that mix with text: value, if and for.</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element ref="value"/>
			<xs:element name="if" type="ifType"/>
			<xs:element name="for" type="forType"/>
		</xs:choice>
	</xs:group>

	<xs:complexType name="content" mixed="true">
		<xs:annotation>
			<xs:documentation>Text plus placeholders, with no attributes.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
	</xs:complexType>

	<xs:simpleType name="literal">
		<xs:annotation>
			<xs:documentation>Plain text. It takes no placeholders.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string"/>
	</xs:simpleType>

	<xs:complexType name="run" mixed="true">
		<xs:annotation>
			<xs:documentation>What a node executes: one request, an argv list, or shell text. A run never mixes two of them.</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0">
			<xs:element name="request" type="request">
				<xs:annotation>
					<xs:documentation>A first-class HTTP request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="argv" type="content" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One argument of the program, with no shell between.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:group ref="placeholders" maxOccurs="unbounded"/>
		</xs:choice>
	</xs:complexType>

	<xs:simpleType name="allowStatus">
		<xs:annotation>
			<xs:documentation>A comma-separated list of statuses from 400 to 599.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="\s*[45][0-9][0-9]\s*(,\s*[45][0-9][0-9]\s*)*"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="request">
		<xs:annotation>
			<xs:documentation>An HTTP request, sent by the built-in client or by a transport.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="url" type="content">
				<xs:annotation>
					<xs:documentation>The URL to request.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="query" type="query" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Query parameters to add to the URL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="header" type="header" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One request header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="if" type="headerIf" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Headers that apply only when test= holds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="body" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The request body.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="response" type="response" minOccurs="0">
				<xs:annotation>
					<xs:documentation>How to shape the response body.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="method" type="xs:token">
			<xs:annotation>
				<xs:documentation>The HTTP method. The default is GET.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="transport" type="xs:token">
			<xs:annotation>
				<xs:documentation>A transport name. "http" selects the built-in client over a registry default. Omit it to take that default.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="allow-status" type="allowStatus">
			<xs:annotation>
				<xs:documentation>Error statuses that return their body rather than fail. Needs the built-in client.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="response">
		<xs:annotation>
			<xs:documentation>The shaping of a response body.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="jq" type="nonEmpty">
			<xs:annotation>
				<xs:documentation>A jq program, rendered as a template first. A bare dotted name reads the program from the context.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="header" mixed="true">
		<xs:annotation>
			<xs:documentation>A name and a value. The text is the value.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The header, parameter or cookie name.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="headerIf">
		<xs:annotation>
			<xs:documentation>Headers that apply only when test= holds.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="header" type="header" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One conditional header.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="test" type="path" use="required">
			<xs:annotation>
				<xs:documentation>A context path, checked for truthiness.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="query">
		<xs:annotation>
			<xs:documentation>Query parameters, listed one by one or read from a map.</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="param" type="header">
				<xs:annotation>
					<xs:documentation>One query parameter.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="if" type="paramIf">
				<xs:annotation>
					<xs:documentation>Parameters that apply only when test= holds.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
		<xs:attribute name="from" type="path">
			<xs:annotation>
				<xs:documentation>A context path to a map. Each key becomes one parameter.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="paramIf">
		<xs:annotation>
			<xs:documentation>Query parameters that apply only when test= holds.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="param" type="header" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One conditional parameter.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="test" type="path" use="required">
			<xs:annotation>
				<xs:documentation>A context path, checked for truthiness.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="transport">
		<xs:annotation>
			<xs:documentation>A program that performs requests and downloads in place of the built-in client.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="run" type="runCommand">
				<xs:annotation>
					<xs:documentation>The program. It sees the request as .request: method, url, headers, header_lines and body.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cwd" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The program's working directory.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stdin" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The program's stdin. Omit it to send the request body. Declare it, even empty, to send something else.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="name" type="transportName" use="required">
			<xs:annotation>
				<xs:documentation>The name a transport= attribute selects it by.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="default" type="bool">
			<xs:annotation>
				<xs:documentation>Carry every request and download that names no transport. At most one transport is the default.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="transportName">
		<xs:annotation>
			<xs:documentation>Any name but "http", which is the built-in client.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="nonEmpty">
			<xs:pattern value="[^h].*|h|h[^t].*|ht|ht[^t].*|htt|htt[^p].*|http.+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="runCommand" mixed="true">
		<xs:annotation>
			<xs:documentation>A program: an argv list or shell text. It cannot be a request.</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0">
			<xs:element name="argv" type="content" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One argument of the program, with no shell between.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:group ref="placeholders" maxOccurs="unbounded"/>
		</xs:choice>
	</xs:complexType>

	<xs:element name="transports">
		<xs:annotation>
			<xs:documentation>The registry of transport programs.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="transport" type="transport" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>One named program.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="transportName">
			<xs:annotation>
				<xs:documentation>Each transport name is used once.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="transport"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

	<xs:complexType name="downloads">
		<xs:annotation>
			<xs:documentation>Settings for the one download queue of the process. A per-leaf hand-off is download.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="concurrency" type="xs:integer">
			<xs:annotation>
				<xs:documentation>How many files transfer at once.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="retries" type="xs:integer">
			<xs:annotation>
				<xs:documentation>How many times a failed transfer runs again, at a fixed cadence. 0 reports a failure at once.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dir" type="nonEmpty">
			<xs:annotation>
				<xs:documentation>The directory a relative to resolves under. --download-dir overrides it.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="hashAlgo">
		<xs:annotation>
			<xs:documentation>md5, sha1, sha256 or sha512, in any casing.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:pattern value="[Mm][Dd]5|[Ss][Hh][Aa]1|[Ss][Hh][Aa]256|[Ss][Hh][Aa]512"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="hash" mixed="true">
		<xs:annotation>
			<xs:documentation>The expected digest of the file, as hex. A mismatch fails the download, and the file never gets its real name.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="algo" type="hashAlgo">
			<xs:annotation>
				<xs:documentation>The digest algorithm. The default is sha256.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="download">
		<xs:annotation>
			<xs:documentation>A hand-off to the download queue, in place of the leaf's run. It repeats per record of over=.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="url" type="content">
				<xs:annotation>
					<xs:documentation>The URL to fetch. Each line it renders is one download.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="to" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The destination. A directory takes the file name from Content-Disposition or from the URL.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="hash" type="hash" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The digest to check the file against.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="header" type="header" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One request header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cookie" type="header" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One cookie. Every cookie folds into one Cookie header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="if" type="downloadIf" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Headers and cookies that apply only when test= holds.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="join" type="join" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Concatenate a group of parts into one file.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="over" type="overExpr">
			<xs:annotation>
				<xs:documentation>The list to repeat over. Each element's keys are promoted, and the element is .item.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate. A record that fails it is not downloaded.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="transport" type="xs:token">
			<xs:annotation>
				<xs:documentation>The program's stdout is the file. Fd 3 ($API_CLI_PROGRESS_FD, .request.progress_fd) takes progress as JSON lines: {"done":N,"total":N}.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="group" type="template">
			<xs:annotation>
				<xs:documentation>The join group this part belongs to. Needs a join.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="order" type="template">
			<xs:annotation>
				<xs:documentation>The part's place in its group, sorted as a number, so 10 comes after 3. Needs a join.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="mock">
		<xs:annotation>
			<xs:documentation>A stand-in for a program, as the leaf's action. Its argv arrives through passthrough. With the leaf's own run, the mock acts and then the real program runs.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="input" type="mockInput" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One named part of the incoming argv.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="output" type="mockOutput" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One file the caller expects to find afterwards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="record" type="mockRecord" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One line appended per call.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stdout" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>What the mock prints to stdout.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stderr" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>What the mock prints to stderr.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="exit" type="template">
			<xs:annotation>
				<xs:documentation>The exit code, which is how a mock stands in for a tool that fails. A leaf with a run takes the program's own code.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="mockInput">
		<xs:annotation>
			<xs:documentation>One named part of the incoming argv. Its value lands at .mock.NAME.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="xs:token" use="required">
			<xs:annotation>
				<xs:documentation>The key under .mock.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="match" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>A regular expression, tested against each element of .rest in order. The first match wins.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="variadic" type="bool">
			<xs:annotation>
				<xs:documentation>Collect every match as a list.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="required" type="bool">
			<xs:annotation>
				<xs:documentation>Fail the call when nothing matches. Not with default=.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="default" type="template">
			<xs:annotation>
				<xs:documentation>The value when nothing matches.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="mockOutput" mixed="true">
		<xs:annotation>
			<xs:documentation>One file the mock writes. The text is the body, empty by default, because a build tool reads the timestamp.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="path" type="template" use="required">
			<xs:annotation>
				<xs:documentation>Where the file lands.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate. The file is written only when it holds.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="over" type="overExpr">
			<xs:annotation>
				<xs:documentation>Write one file per element of this list.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="from" type="template">
			<xs:annotation>
				<xs:documentation>Copy this existing file in place of the body. Not with a body.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="append" type="bool">
			<xs:annotation>
				<xs:documentation>Add to the file rather than replace it.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="mode" type="xs:token">
			<xs:annotation>
				<xs:documentation>The file mode in octal. The default is 0644.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="mockRecord" mixed="true">
		<xs:annotation>
			<xs:documentation>One line appended per call. The default body is a compile_commands.json entry, so a build writes its own compilation database.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="path" type="template" use="required">
			<xs:annotation>
				<xs:documentation>The file the line is appended to.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate. The line is written only when it holds.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="join">
		<xs:annotation>
			<xs:documentation>The one file a group of parts becomes. Each part keeps its own to, and the join concatenates them.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="to" type="template" use="required">
			<xs:annotation>
				<xs:documentation>The output file.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="cleanup" type="bool">
			<xs:annotation>
				<xs:documentation>Remove the parts, and the directories they leave empty, after the output lands.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="contiguous" type="joinGap">
			<xs:annotation>
				<xs:documentation>Report a gap in the order= numbers of a group.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="joinGap">
		<xs:annotation>
			<xs:documentation>"warn" logs the gap and writes the file. "error" fails the group.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="warn"/>
			<xs:enumeration value="error"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="downloadIf">
		<xs:annotation>
			<xs:documentation>Headers and cookies that apply only when test= holds.</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="header" type="header">
				<xs:annotation>
					<xs:documentation>One conditional header.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cookie" type="header">
				<xs:annotation>
					<xs:documentation>One conditional cookie.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
		<xs:attribute name="test" type="path" use="required">
			<xs:annotation>
				<xs:documentation>A context path, checked for truthiness.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="fieldAttrs">
		<xs:annotation>
			<xs:documentation>The attributes every field takes.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The column heading or key.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="default" type="xs:string">
			<xs:annotation>
				<xs:documentation>The text for an empty value.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="truncate" type="xs:integer">
			<xs:annotation>
				<xs:documentation>Cap the value at this many characters.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="firstline" type="bool">
			<xs:annotation>
				<xs:documentation>Keep only the first line.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="priority" type="xs:integer">
			<xs:annotation>
				<xs:documentation>The lowest priority column drops first when a table is too narrow. The default is 0.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="show_in" type="xs:token">
			<xs:annotation>
				<xs:documentation>The sinks that show the field: "*" for all, "json,csv" for only those, "!json" for all but that.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="fieldByExpr">
		<xs:annotation>
			<xs:documentation>A computed field. Its body is empty.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="fieldAttrs">
				<xs:attribute name="expr" type="nonEmpty" use="required">
					<xs:annotation>
						<xs:documentation>A template with the record promoted and the whole context as $.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="fieldByPath">
		<xs:annotation>
			<xs:documentation>A field read from the record. The body is a record-relative path, such as "user.login" or "assets.0.name".</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="path">
				<xs:attribute name="name" type="nonEmpty" use="required">
					<xs:annotation>
						<xs:documentation>The column heading or key.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="default" type="xs:string">
					<xs:annotation>
						<xs:documentation>The text for an empty value.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="truncate" type="xs:integer">
					<xs:annotation>
						<xs:documentation>Cap the value at this many characters.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="firstline" type="bool">
					<xs:annotation>
						<xs:documentation>Keep only the first line.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="priority" type="xs:integer">
					<xs:annotation>
						<xs:documentation>The lowest priority column drops first when a table is too narrow. The default is 0.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="show_in" type="xs:token">
					<xs:annotation>
						<xs:documentation>The sinks that show the field: "*" for all, "json,csv" for only those, "!json" for all but that.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="expr" use="prohibited"/>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="fields">
		<xs:annotation>
			<xs:documentation>The output shape, drawn as a table, list, json, csv and more. Every block whose when= holds renders, in order.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="field" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One column. expr= computes it. Otherwise the body is a path.</xs:documentation>
				</xs:annotation>
				<xs:alternative test="@expr" type="fieldByExpr"/>
				<xs:alternative type="fieldByPath"/>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="over" type="path">
			<xs:annotation>
				<xs:documentation>Where the records live: read against the body first, then the whole context.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="footer" type="template">
			<xs:annotation>
				<xs:documentation>A line printed after the records.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate over the format context. The block renders only when it holds.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="tmlFieldByExpr">
		<xs:annotation>
			<xs:documentation>A computed part of a list item.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The property of the item template.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="expr" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>A template. The element's keys are promoted, .item and .index name it, and $ is the whole run.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="lines" type="bool">
			<xs:annotation>
				<xs:documentation>Cut the value into a list of lines.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="last" type="xs:token">
			<xs:annotation>
				<xs:documentation>Keep this many of the last lines. A template.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="truncate" type="xs:token">
			<xs:annotation>
				<xs:documentation>Clip each line to this many cells, ellipsis included. A template.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="tmlFieldByPath">
		<xs:annotation>
			<xs:documentation>A part of a list item, read from the element. The body is a path inside the element.</xs:documentation>
		</xs:annotation>
		<xs:simpleContent>
			<xs:extension base="path">
				<xs:attribute name="name" type="nonEmpty" use="required">
					<xs:annotation>
						<xs:documentation>The property of the item template.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="expr" use="prohibited"/>
				<xs:attribute name="lines" type="bool">
					<xs:annotation>
						<xs:documentation>Cut the value into a list of lines.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="last" type="xs:token">
					<xs:annotation>
						<xs:documentation>Keep this many of the last lines. A template.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="truncate" type="xs:token">
					<xs:annotation>
						<xs:documentation>Clip each line to this many cells, ellipsis included. A template.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>

	<xs:complexType name="propOver">
		<xs:annotation>
			<xs:documentation>A list prop. Each field maps one part of an element to one property of the item.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="field" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One part of each item. A list prop needs at least one.</xs:documentation>
				</xs:annotation>
				<xs:alternative test="@expr" type="tmlFieldByExpr"/>
				<xs:alternative type="tmlFieldByPath"/>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The component property it sets.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="over" type="path" use="required">
			<xs:annotation>
				<xs:documentation>The context path of the list.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="from" use="prohibited"/>
	</xs:complexType>

	<xs:complexType name="propFrom">
		<xs:annotation>
			<xs:documentation>A prop read from one path. It has no body.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The component property it sets.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="from" type="path" use="required">
			<xs:annotation>
				<xs:documentation>A path into the response body, or into the leaf context.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="over" use="prohibited"/>
	</xs:complexType>

	<xs:complexType name="propText" mixed="true">
		<xs:annotation>
			<xs:documentation>A prop whose value is its own text, rendered as a template.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The component property it sets.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="from" use="prohibited"/>
		<xs:attribute name="over" use="prohibited"/>
	</xs:complexType>

	<xs:complexType name="tml">
		<xs:annotation>
			<xs:documentation>A screen: a TML component drawn from the leaf's result. It needs a terminal, and piped output falls back to the rest of the chain.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="prop" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>One component property. over= makes a list, from= reads a path, and otherwise the text is the value.</xs:documentation>
				</xs:annotation>
				<xs:alternative test="@over" type="propOver"/>
				<xs:alternative test="@from" type="propFrom"/>
				<xs:alternative type="propText"/>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="src" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The .tml file, relative to the config.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dark" type="bool">
			<xs:annotation>
				<xs:documentation>Draw with the dark theme.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="formatInput">
		<xs:annotation>
			<xs:documentation>How a format reads the body: "json" (the default), "lines" or "raw".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value="json"/>
			<xs:enumeration value="lines"/>
			<xs:enumeration value="raw"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="view" mixed="true">
		<xs:annotation>
			<xs:documentation>One rendering of a format. The text is the template.</xs:documentation>
		</xs:annotation>
		<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The name --view selects it by.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate. The earliest view whose predicate holds renders.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="default" type="bool">
			<xs:annotation>
				<xs:documentation>The view to use when no when= holds.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:element name="format">
		<xs:annotation>
			<xs:documentation>The legacy presentation: templates in place of fields. A leaf uses fields or format, never both.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="view" type="view" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>One rendering.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="name" type="nonEmpty">
				<xs:annotation>
					<xs:documentation>The name a ref= selects a top-level format by.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="ref" type="nonEmpty">
				<xs:annotation>
					<xs:documentation>On a leaf, the name of a top-level format to use.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="input" type="formatInput">
				<xs:annotation>
					<xs:documentation>How to read the body.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="when" type="template">
				<xs:annotation>
					<xs:documentation>A predicate. The format applies only when it holds and the user allows formatting.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
		<xs:unique name="viewName">
			<xs:annotation>
				<xs:documentation>Each view name is used once per format.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="view"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

	<xs:element name="formats">
		<xs:annotation>
			<xs:documentation>Named formats that leaves select with ref=.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="format" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="formatName">
			<xs:annotation>
				<xs:documentation>Each format name is used once.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="format"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

	<xs:simpleType name="argType">
		<xs:annotation>
			<xs:documentation>"string" (the default, also "") or "int".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value=""/>
			<xs:enumeration value="string"/>
			<xs:enumeration value="int"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="flagType">
		<xs:annotation>
			<xs:documentation>"string" (the default, also ""), "bool", "int" or "string-slice".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:enumeration value=""/>
			<xs:enumeration value="string"/>
			<xs:enumeration value="bool"/>
			<xs:enumeration value="int"/>
			<xs:enumeration value="string-slice"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="arg">
		<xs:annotation>
			<xs:documentation>A positional argument, at .arg.NAME.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The key under .arg.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="type" type="argType">
			<xs:annotation>
				<xs:documentation>The value's type.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="required" type="bool">
			<xs:annotation>
				<xs:documentation>Fail when it is missing. A required arg cannot follow an optional one.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="variadic" type="bool">
			<xs:annotation>
				<xs:documentation>Collect the rest of the arguments as a list. It comes last.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="pattern" type="nonEmpty">
			<xs:annotation>
				<xs:documentation>A regular expression every value must match. Each arg of a runnable node needs one.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="description" type="xs:string">
			<xs:annotation>
				<xs:documentation>The help text.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:simpleType name="shortFlag">
		<xs:annotation>
			<xs:documentation>One character, spelled -x on the command line.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:length value="1"/>
			<xs:pattern value="[^\s]"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="flagName">
		<xs:annotation>
			<xs:documentation>Any name that does not start with "no-", which cobra owns for a bool's negation.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:pattern value="([^n].*)|(n)|(n[^o].*)|(no)|(no[^-].*)"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="flagAttrs">
		<xs:annotation>
			<xs:documentation>The attributes every flag takes.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="name" type="flagName" use="required">
			<xs:annotation>
				<xs:documentation>The long name, and the key under .flag.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="short" type="shortFlag">
			<xs:annotation>
				<xs:documentation>The one-letter name.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="type" type="flagType">
			<xs:annotation>
				<xs:documentation>The value's type.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="required" type="bool">
			<xs:annotation>
				<xs:documentation>Fail when it is missing.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="conflicts" type="xs:token">
			<xs:annotation>
				<xs:documentation>A comma-separated list of flags on the same node that cannot appear with it.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="description" type="xs:string">
			<xs:annotation>
				<xs:documentation>The help text.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:complexType name="flagOfInt">
		<xs:annotation>
			<xs:documentation>An int flag.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="flagAttrs">
				<xs:attribute name="default" type="xs:integer">
					<xs:annotation>
						<xs:documentation>The value when the flag is absent.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="flagOfBool">
		<xs:annotation>
			<xs:documentation>A bool flag. It takes no value on the command line.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="flagAttrs">
				<xs:attribute name="default" type="bool">
					<xs:annotation>
						<xs:documentation>The value when the flag is absent.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:complexType name="flagOfString">
		<xs:annotation>
			<xs:documentation>A string or string-slice flag.</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="flagAttrs">
				<xs:attribute name="default" type="xs:string">
					<xs:annotation>
						<xs:documentation>The value when the flag is absent. A template. A string-slice default is a comma-separated list.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="vars">
		<xs:annotation>
			<xs:documentation>Named values at .var. A var may read another, and they resolve to a fixpoint.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="var" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>One value. The text is a template.</xs:documentation>
					</xs:annotation>
					<xs:complexType mixed="true">
						<xs:group ref="placeholders" minOccurs="0" maxOccurs="unbounded"/>
						<xs:attribute name="name" type="path" use="required">
							<xs:annotation>
								<xs:documentation>The key under .var.</xs:documentation>
							</xs:annotation>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="varName">
			<xs:annotation>
				<xs:documentation>Each var name is used once per block.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="var"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

	<xs:complexType name="preconditions">
		<xs:annotation>
			<xs:documentation>Guards that run before the steps. Ancestors' guards run first.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="precondition" type="content" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A template. Non-empty output fails the run with that text.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:element name="entry">
		<xs:annotation>
			<xs:documentation>Data at .entry, as JSON. Its children are the object's keys, so the schema cannot constrain them.</xs:documentation>
		</xs:annotation>
	</xs:element>

	<xs:complexType name="step">
		<xs:annotation>
			<xs:documentation>One step before the leaf's action. It runs its own run, or the leaf's with its own entry. Its result is at .steps.NAME.</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="run" type="run" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The step's own run. Without it, the step runs the leaf's.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="entry" minOccurs="0"/>
			<xs:element name="cwd" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The working directory for this step.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stdin" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The stdin for this step.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:all>
		<xs:attribute name="name" type="nonEmpty" use="required">
			<xs:annotation>
				<xs:documentation>The key under .steps.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="when" type="template">
			<xs:annotation>
				<xs:documentation>A predicate. The step runs only when it holds.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="over" type="overExpr">
			<xs:annotation>
				<xs:documentation>Run once per element, at .item and .index. The result is a list of item and result pairs.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="until" type="template">
			<xs:annotation>
				<xs:documentation>Poll: repeat until this predicate holds. It reads the last body as .status and .body.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="interval" type="xs:token">
			<xs:annotation>
				<xs:documentation>The fixed wait between polls.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="attempts" type="xs:integer">
			<xs:annotation>
				<xs:documentation>The most polls before the step fails with the last body.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="retries" type="xs:nonNegativeInteger">
			<xs:annotation>
				<xs:documentation>Run a failed attempt again this many times, one second apart. It applies to each poll and each element.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="on-error">
			<xs:annotation>
				<xs:documentation>An element that still fails: "fail" stops the run, "skip" drops it and exits 1 with a summary. skip needs over=.</xs:documentation>
			</xs:annotation>
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:enumeration value="fail"/>
					<xs:enumeration value="skip"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:complexType>

	<xs:element name="steps">
		<xs:annotation>
			<xs:documentation>Steps that run in order before the leaf's action.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="step" type="step" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>One step.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
		<xs:unique name="stepName">
			<xs:annotation>
				<xs:documentation>Each step name is used once per leaf.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="step"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

	<xs:simpleType name="nameChars">
		<xs:annotation>
			<xs:documentation>A name with no whitespace and no slash.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:minLength value="1"/>
			<xs:pattern value="[^\s/]+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="notHelp">
		<xs:annotation>
			<xs:documentation>Any name but "help". The pattern matches what differs from the word or carries more than it.</xs:documentation>
		</xs:annotation>
		<xs:restriction base="nameChars">
			<xs:pattern value="[^h].*|h|h[^e].*|he|he[^l].*|hel|hel[^p].*|help.+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="notDocs">
		<xs:annotation>
			<xs:documentation>Any name but "help" or "docs".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="notHelp">
			<xs:pattern value="[^d].*|d|d[^o].*|do|do[^c].*|doc|doc[^s].*|docs.+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="notCompletion">
		<xs:annotation>
			<xs:documentation>Any name but "help", "docs" or "completion".</xs:documentation>
		</xs:annotation>
		<xs:restriction base="notDocs">
			<xs:pattern value="[^c].*|c|c[^o].*|co|co[^m].*|com|com[^p].*|comp|comp[^l].*|compl|compl[^e].*|comple|comple[^t].*|complet|complet[^i].*|completi|completi[^o].*|completio|completio[^n].*|completion.+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="commandName">
		<xs:annotation>
			<xs:documentation>A command name: no whitespace, no slash, and none of the names cobra owns (help, docs, completion, __complete).</xs:documentation>
		</xs:annotation>
		<xs:restriction base="notCompletion">
			<xs:pattern value="[^_].*|_|_[^_].*|__|__[^c].*|__c|__c[^o].*|__co|__co[^m].*|__com|__com[^p].*|__comp|__comp[^l].*|__compl|__compl[^e].*|__comple|__comple[^t].*|__complet|__complet[^e].*|__complete.+"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="command">
		<xs:annotation>
			<xs:documentation>A node of the command tree. A leaf runs. A parent groups its subcommands, and runs too with runnable="true".</xs:documentation>
		</xs:annotation>
		<xs:all>
			<xs:element name="arg" type="arg" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A positional argument.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="flag" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A flag, at .flag.NAME. Its default= is checked against its type=.</xs:documentation>
				</xs:annotation>
				<xs:alternative test="@type = 'int'" type="flagOfInt"/>
				<xs:alternative test="@type = 'bool'" type="flagOfBool"/>
				<xs:alternative type="flagOfString"/>
			</xs:element>
			<xs:element ref="vars" minOccurs="0"/>
			<xs:element name="run" type="run" minOccurs="0">
				<xs:annotation>
					<xs:documentation>What the node executes. It inherits from the nearest ancestor.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="cwd" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The working directory of the run. It inherits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="stdin" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>The stdin of the run. It inherits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="confirm" type="content" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A prompt to answer before the run. --yes skips it. It inherits.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="preconditions" type="preconditions" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Guards for this node, after its ancestors' guards.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="steps" minOccurs="0"/>
			<xs:element ref="entry" minOccurs="0"/>
			<xs:element name="fields" type="fields" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>The output shape.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="tml" type="tml" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A screen in place of fields. Not with fields.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="format" minOccurs="0"/>
			<xs:element name="download" type="download" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>A hand-off to the download queue, as the leaf's action.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="mock" type="mock" minOccurs="0">
				<xs:annotation>
					<xs:documentation>A stand-in for a program, as the leaf's action.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element ref="command" minOccurs="0" maxOccurs="unbounded"/>
		</xs:all>
		<xs:attribute name="name" type="commandName" use="required">
			<xs:annotation>
				<xs:documentation>The command's name on the command line.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="description" type="xs:string">
			<xs:annotation>
				<xs:documentation>The help text.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="passthrough" type="bool">
			<xs:annotation>
				<xs:documentation>Take every argument as is, at .rest. Leaf-only, and not with arg or runnable=.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="runnable" type="bool">
			<xs:annotation>
				<xs:documentation>A parent that also runs. Each arg then needs a pattern= that matches no subcommand name.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="confirm" type="xs:string">
			<xs:annotation>
				<xs:documentation>A prompt to answer before the run, as an attribute. --yes skips it. It inherits.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="watch" type="interval">
			<xs:annotation>
				<xs:documentation>Repeat the node on this interval and repaint in place. It inherits. --watch overrides it, and "off" runs once.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<xs:element name="command" type="command">
		<xs:annotation>
			<xs:documentation>One command. It is global so every depth checks sibling names.</xs:documentation>
		</xs:annotation>
		<xs:unique name="subcommandName">
			<xs:annotation>
				<xs:documentation>Each subcommand name is used once among siblings.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="command"/>
			<xs:field xpath="@name"/>
		</xs:unique>
		<xs:unique name="argName">
			<xs:annotation>
				<xs:documentation>Each arg name is used once per command.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="arg"/>
			<xs:field xpath="@name"/>
		</xs:unique>
		<xs:unique name="flagName">
			<xs:annotation>
				<xs:documentation>Each flag name is used once per command.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="flag"/>
			<xs:field xpath="@name"/>
		</xs:unique>
		<xs:unique name="flagShort">
			<xs:annotation>
				<xs:documentation>Each short flag is used once per command.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="flag"/>
			<xs:field xpath="@short"/>
		</xs:unique>
	</xs:element>

	<xs:element name="config">
		<xs:annotation>
			<xs:documentation>The root of a config.</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="description" type="literal" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The help text of the root command.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="vars" minOccurs="0"/>
				<xs:element ref="transports" minOccurs="0"/>
				<xs:element name="downloads" type="downloads" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Settings for the download queue.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="run" type="run" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The run every command inherits unless it declares its own.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="cwd" type="content" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The working directory every command inherits.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="stdin" type="content" minOccurs="0">
					<xs:annotation>
						<xs:documentation>The stdin every command inherits.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="preconditions" type="preconditions" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Guards that run before every run in the tree, ahead of each node's own.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="formats" minOccurs="0"/>
				<xs:element ref="command" minOccurs="0" maxOccurs="unbounded"/>
			</xs:all>
			<xs:attribute name="name" type="nonEmpty" use="required">
				<xs:annotation>
					<xs:documentation>The root command's name.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
			<xs:attribute name="schema" type="xs:string">
				<xs:annotation>
					<xs:documentation>An editor hint that points at this schema. The loader ignores it.</xs:documentation>
				</xs:annotation>
			</xs:attribute>
		</xs:complexType>
		<xs:unique name="topCommandName">
			<xs:annotation>
				<xs:documentation>Each top-level command name is used once.</xs:documentation>
			</xs:annotation>
			<xs:selector xpath="command"/>
			<xs:field xpath="@name"/>
		</xs:unique>
	</xs:element>

</xs:schema>
