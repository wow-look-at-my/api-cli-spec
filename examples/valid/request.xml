<?xml version="1.1" encoding="UTF-8"?>
<!-- A first-class request: query, conditional headers, body, jq, allow-status. -->
<config name="request">
	<run>
		<request method="GET" transport="http" allow-status="404, 410">
			<url>https://example.invalid/<value name="entry.path"/></url>
			<query from="entry.query">
				<param name="page"><value name="flag.page" default="1"/></param>
				<if test="flag.limit">
					<param name="limit"><value name="flag.limit"/></param>
				</if>
			</query>
			<header name="Accept">application/json</header>
			<if test="var.token">
				<header name="Authorization">Bearer <value name="var.token"/></header>
			</if>
			<body>{"note": "<value name="flag.note"/>"}</body>
			<response jq=".items | map(.id)"/>
		</request>
	</run>
	<command name="items" description="List items.">
		<flag name="page" type="int" default="1" description="Page number."/>
		<flag name="limit" type="int" description="Page size."/>
		<flag name="note" type="string" description="A note to send."/>
		<entry>
			<path>items</path>
			<query>
				<param name="sort">name</param>
			</query>
		</entry>
	</command>
</config>
