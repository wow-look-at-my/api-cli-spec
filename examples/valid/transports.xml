<?xml version="1.1" encoding="UTF-8"?>
<!-- Two programs that carry a request, one of them the registry default. -->
<config name="transports">
	<transports>
		<transport name="curl" default="true">
			<run>
				<argv>curl</argv>
				<argv>-sSL</argv>
				<argv>-X</argv>
				<argv><value name="request.method"/></argv>
				<argv><value name="request.url"/></argv>
			</run>
			<cwd>/tmp</cwd>
			<stdin><value name="request.body"/></stdin>
		</transport>
		<transport name="proxy">
			<run>proxyctl fetch <value name="request.url" as="shellquote"/></run>
		</transport>
	</transports>
	<command name="get" description="Fetch a document through the default transport.">
		<run>
			<request>
				<url>https://example.invalid/doc</url>
			</request>
		</run>
	</command>
	<command name="get-direct" description="Fetch it with the built-in client instead.">
		<run>
			<request transport="http">
				<url>https://example.invalid/doc</url>
			</request>
		</run>
	</command>
</config>
