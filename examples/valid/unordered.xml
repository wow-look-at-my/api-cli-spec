<?xml version="1.1" encoding="UTF-8"?>
<!--
	The loader dispatches on an element name rather than on its position, so
	every child order below loads. This fixture is what keeps the schema from
	drifting back to a fixed order.
-->
<config name="unordered">
	<command name="show" description="Its children run backwards.">
		<fields over="data">
			<field name="ID">id</field>
		</fields>
		<entry>
			<path>things</path>
		</entry>
		<run>
			<request>
				<response jq=".things"/>
				<body/>
				<header name="Accept">application/json</header>
				<query>
					<param name="all">1</param>
				</query>
				<url>https://example.invalid/<value name="entry.path"/></url>
			</request>
		</run>
		<flag name="all" type="bool" description="Ask for everything."/>
		<arg name="id" type="int" description="One thing."/>
	</command>
	<vars>
		<var name="env">prod</var>
	</vars>
	<description>Declared after the command it describes.</description>
</config>
