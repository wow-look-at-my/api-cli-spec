<?xml version="1.1" encoding="UTF-8"?>
<!--
	The loader reads required="1" as false, silently. The schema is stricter
	here on purpose: see the divergence note in README.md.
-->
<!-- rejects: attribute "required" on element "arg": value "1" is not one of the allowed values: true, false -->
<config name="x">
	<command name="c">
		<arg name="id" type="int" required="1"/>
		<run>x</run>
	</command>
</config>
