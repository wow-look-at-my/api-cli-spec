<?xml version="1.1" encoding="UTF-8"?>
<!--
	The command tree: nesting, a runnable parent, a passthrough leaf, every arg
	and flag type, steps that repeat, and the inherited settings.
-->
<config name="tree" schema="1">
	<description>A tree that exercises the structural grammar.</description>
	<cwd>/tmp</cwd>
	<stdin/>
	<run>echo root</run>
	<command name="repo" description="Work with a repository." runnable="true">
		<arg name="ref" type="string" pattern="^[0-9a-f]{7,40}$" description="A commit to inspect."/>
		<vars>
			<var name="dir">/srv/<value name="flag.name"/></var>
		</vars>
		<flag name="name" type="string" required="true" description="Repository name."/>
		<flag name="depth" type="int" default="1" description="History depth."/>
		<flag name="bare" type="bool" default="false" conflicts="mirror" description="Clone bare."/>
		<flag name="mirror" type="bool" default="false" description="Clone a mirror."/>
		<flag name="tags" type="string-slice" default="v1,v2" short="t" description="Tags to fetch."/>
		<confirm>Inspect <value name="arg.ref"/>?</confirm>
		<preconditions>
			<precondition>{{ fileExists .var.dir }}</precondition>
		</preconditions>
		<run>git -C <value name="var.dir"/> show <value name="arg.ref"/></run>
		<command name="list" description="List the branches.">
			<run>git -C <value name="var.dir"/> branch</run>
		</command>
		<command name="sync" description="Fetch each remote in turn.">
			<steps>
				<step name="remotes">
					<run>git -C <value name="var.dir"/> remote</run>
				</step>
				<step name="fetch" over="result.remotes.lines" when="{{ truthy .result.remotes.lines }}">
					<run>git -C <value name="var.dir"/> fetch <value name="item"/></run>
					<cwd><value name="var.dir"/></cwd>
					<stdin/>
				</step>
			</steps>
		</command>
	</command>
	<command name="sh" description="Pass every argument through to the shell." passthrough="true">
		<run>sh -c <value name="rest" as="shellquote"/></run>
	</command>
</config>
