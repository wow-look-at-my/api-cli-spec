<?xml version="1.1" encoding="UTF-8"?>
<!--
	A transport declares its own cwd and stdin. Those belong to the transport's
	program, not to the command tree, so neither command inherits them.
-->
<resolved config="transports">
	<command path="/get" runs="true">
		<run from="/get" kind="request"/>
	</command>
	<command path="/get-direct" runs="true">
		<run from="/get-direct" kind="request"/>
	</command>
</resolved>
