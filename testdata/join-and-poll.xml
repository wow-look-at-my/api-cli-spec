<?xml version="1.1" encoding="UTF-8"?>
<!-- A polling step, and parts that concatenate into one file per group. -->
<config name="join-and-poll">
	<command name="capture" description="Wait for a capture, then fetch and join its parts.">
		<arg name="id" type="string" required="true" description="Capture id."/>
		<steps>
			<step name="job" until="{{ eq .result.job.data.state &quot;done&quot; }}" interval="5s" attempts="60">
				<run>
					<request>
						<url>https://example.invalid/captures/<value name="arg.id"/></url>
					</request>
				</run>
			</step>
		</steps>
		<!-- over= is a path here, or a template whose output is read as JSON. -->
		<download over="{{ toJson .result.job.data.parts }}" group="{{ .stream }}" order="{{ .index }}">
			<url><value name="item.url"/></url>
			<to>parts/<value name="item.stream"/>-<value name="item.index"/>.ts</to>
			<join to="out/{{ .stream }}.ts" cleanup="true" contiguous="error"/>
		</download>
		<!-- A join with a run hands the joined parts to a program, which writes the output. -->
		<download over="{{ toJson .result.job.data.parts }}" group="{{ .stream }}" order="{{ .index }}">
			<url><value name="item.url"/></url>
			<to><value name="run.tmpdir"/>/<value name="item.stream"/>-<value name="item.index"/>.h264</to>
			<join to="out/{{ .stream }}.mp4" cleanup="true">
				<run>
					<argv>ffmpeg</argv>
					<argv>-i</argv>
					<argv><value name="join.input"/></argv>
					<argv>-c</argv>
					<argv>copy</argv>
					<argv>-f</argv>
					<argv>mp4</argv>
					<argv><value name="join.output"/></argv>
				</run>
			</join>
		</download>
	</command>
</config>
