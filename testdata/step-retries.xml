<?xml version="1.1" encoding="UTF-8"?>
<!-- A repeated poll that retries a failed call and skips an element that still fails. -->
<config name="step-retries">
	<command name="wait" description="Wait for every job, then fetch what the finished ones made.">
		<arg name="ids" type="string" variadic="true" description="Job ids."/>
		<steps>
			<step name="jobs" over="arg.ids" until="{{ eq .status &quot;done&quot; }}" interval="2s" attempts="30" retries="3" on-error="skip">
				<run>
					<request>
						<url>https://example.invalid/jobs/<value name="item"/></url>
						<response jq="."/>
					</request>
				</run>
			</step>
		</steps>
		<download over="result.jobs">
			<url><value name="result.url"/></url>
			<to>out/<value name="item.item"/>.bin</to>
		</download>
	</command>
</config>
